{
  "name": "notecom-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "tauri": "tauri",
    "dev:desktop": "tauri dev --config desktop/tauri.conf.json",
    "build:desktop": "tauri build --config desktop/tauri.conf.json",
    "postbuild:desktop": "node scripts/install-desktop.mjs",
    "install:desktop": "npm install && npm run build:desktop"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "framer-motion": "^11.11.17",
    "mermaid": "^11.4.1",
    "next": "^15.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  },
  "//overrides": "Force patched transitive deps of next (postcss XSS, sharp/libvips CVEs) without downgrading next 15. sharp is unused here (no next/image); the pin just clears the advisory.",
  "overrides": {
    "postcss": "^8.5.10",
    "sharp": "^0.35.0"
  }
}
