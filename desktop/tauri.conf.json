{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Notecom",
  "version": "0.1.0",
  "identifier": "com.universitynotes.notecom",
  "build": {
    "frontendDist": "assets",
    "beforeDevCommand": "node scripts/ensure-desktop-sidecars.mjs",
    "beforeBuildCommand": "node scripts/prepare-desktop-resources.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/frontend/**/*", "resources/claude-project/**/*"],
    "externalBin": ["bin/node"]
  }
}
