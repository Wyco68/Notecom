# Personal lesson vault — never shipped in the public template.
# Each user's own subjects/lessons live here, generated locally by savelesson.
/vault/

# Built binaries — built locally at setup time (see README), not committed.
tools/vaultd/vaultd.exe
tools/vaultd/vaultd
tools/indexd/indexd.exe
tools/indexd/indexd
tools/stored/stored.exe
tools/stored/stored
# Go leaves these behind when it rebuilds over a running binary.
*.exe~

# Incremental type-check cache — regenerated by every tsc run.
tsconfig.tsbuildinfo

# Local Claude subscription credential (encrypted) — never committed.
/.claude-token.enc
/.claude-secret.key

# Editor/tooling local state
.impeccable/
**/.impeccable/

# Next.js web app
/node_modules/
/.next/
.env.local

# Content-repo mirror state (scripts/sync-content.mjs) — local git dir for
# pushing vault/ to the private lecture-content repo, never committed here.
/.content-git/

# Cloudflare Worker (workers/content-api) local artifacts
workers/content-api/node_modules/
workers/content-api/.wrangler/
workers/content-api/.dev.vars
workers/content-api/.secrets.local

# Desktop shell — Rust build output and generated sidecar/resource artifacts
# (see scripts/ensure-desktop-sidecars.mjs, scripts/prepare-desktop-resources.mjs)
desktop/target/
desktop/bin/
desktop/resources/
desktop/gen/

# Collected installer(s) from the last `npm run build:desktop`
# (copied here by scripts/install-desktop.mjs) — build output, not source.
/installation/
.vercel
.env*
