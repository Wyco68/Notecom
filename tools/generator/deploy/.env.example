# Copy to .env.production on the VPS, fill in, `chmod 600 .env.production`.
# Never commit the filled-in file. (NATS_TOKEN goes in a separate .env —
# see docker-compose.yml.)

# The notes_generator role (migration 0036) through the Supavisor SESSION
# pooler (port 5432 — the relay LISTENs, which transaction mode can't do).
# The user is notes_generator.<project-ref>; the password is the one you set
# with `alter role notes_generator with login password '...'`. Keyword form,
# so the password needs no URL-encoding; keep the double quotes. The pooler
# host is per project (aws-0-… or aws-1-…): the right one answers "password
# authentication failed" to a wrong password, the wrong one "tenant/user not
# found".
DATABASE_URL="host=aws-1-<region>.pooler.supabase.com port=5432 dbname=postgres user=notes_generator.<project-ref> password=<password> sslmode=require"

# The project's own origin: signed upload URLs are rebuilt against it.
SUPABASE_URL=https://<project-ref>.supabase.co

# The same secret the app (Vercel) uses to encrypt readers' keys.
AI_KEYS_SECRET=

# Jobs worked at once. Two fit the default memory limit.
WORKER_CONCURRENCY=2
